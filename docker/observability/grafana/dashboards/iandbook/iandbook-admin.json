        {
          "refId": "A",
          "datasource": {
            "type": "grafana-x-ray-datasource",
            "uid": "xray"
          },
          "queryType": "getTraceSummaries",
          "query": "service(\"iandbook-admin-v2\")",
          "region": "default",
          "columns": []
        }
      ]
    },
    {
      "id": 7,
      "title": "최근 v2 오류 (5xx 응답과 ERROR 로그)",
      "type": "table",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "logGroups": [
            {
              "arn": "arn:aws:logs:ap-northeast-2:823624329122:log-group:/iandbook/v2:*",
              "name": "/iandbook/v2"
            }
          ],
          "logGroupNames": [
            "/iandbook/v2"
          ],
          "expression": "fields @timestamp, @message | filter @message like /status=5|ERROR \\[/ | sort @timestamp desc | limit 50",
          "statsGroups": []
        }
      ]
    },
    {
      "id": 8,
      "title": "화면별 사용량과 응답 시간",
      "type": "table",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "logGroups": [
            {
              "arn": "arn:aws:logs:ap-northeast-2:823624329122:log-group:/iandbook/v2:*",
              "name": "/iandbook/v2"
            }
          ],
          "logGroupNames": [
            "/iandbook/v2"
          ],
          "expression": "filter @message like /request method=/ | parse @message 'method=* path=* status=* ms=* user=*' as method, path, status, ms, user | stats count(*) as requests, avg(ms) as avg_ms, pct(ms, 95) as p95_ms, max(ms) as max_ms, count_distinct(user) as users by method, path | sort requests desc | limit 30",
          "statsGroups": []
        }
      ],
      "description": "p95_ms: 요청을 빠른 순으로 세웠을 때 95% 지점의 응답 시간(20번 중 1번은 이보다 느림)."
    },
    {
      "id": 9,
      "title": "Trace-Id 로 요청 찾기 (위 Trace-Id 칸에 응답 헤더 값을 넣는다. xray 칸을 누르면 X-Ray trace 가 열린다)",
      "type": "table",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "logGroups": [
            {
              "arn": "arn:aws:logs:ap-northeast-2:823624329122:log-group:/iandbook/v2/otel:*",
              "name": "/iandbook/v2/otel"
            }
          ],
          "logGroupNames": [
            "/iandbook/v2/otel"
          ],
          "expression": "fields @timestamp, severity_text, body, scope.name, span_id, concat('1-', substr(trace_id, 0, 8), '-', substr(trace_id, 8)) as xray | filter trace_id = '$trace_id' | sort @timestamp asc | limit 200",
          "statsGroups": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "xray"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "X-Ray trace 열기",
                    "url": "",
                    "internal": {
                      "datasourceUid": "xray",
                      "datasourceName": "X-Ray",
                      "query": {
                        "queryType": "getTrace",
                        "query": "${__value.raw}",
                        "region": "default"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
