# actuator 는 관리 포트로 분리하고 ingress 로 열지 않는다. probe 와 prometheus 수집은 이 포트를 쓴다.
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
TRACING_SAMPLING_PROBABILITY=0.1
TASK_SERVICE_URI=http://task-service:8084
# 클라이언트가 보는 외부 주소 (로컬: kubectl port-forward -n traefik svc/traefik 18080:80)
AUTH_ISSUER_URI=http://auth.localtest.me:18080
AUTH_JWK_SET_URI=http://auth-server:9400/oauth2/jwks
REDIS_HOST=redis
REDIS_PORT=6379
# kubernetes 에서는 eureka / config server / bus 대신 service DNS 와 ConfigMap 을 쓴다.
SPRING_CLOUD_BOOTSTRAP_ENABLED=false
SPRING_CLOUD_CONFIG_ENABLED=false
SPRING_CLOUD_BUS_ENABLED=false
EUREKA_CLIENT_ENABLED=false
MANAGEMENT_HEALTH_RABBIT_ENABLED=false
SPRING_RABBITMQ_LISTENER_SIMPLE_AUTO_STARTUP=false
